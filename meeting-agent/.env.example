# --- LLM (drives the agent and the summarizer) -------------------------------
# Set at least one. Anthropic is recommended.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Speech-to-text ----------------------------------------------------------
# STT_ENGINE: auto | api | local
#   api   -> OpenAI-compatible /audio/transcriptions (needs OPENAI_API_KEY)
#   local -> faster-whisper, fully offline (needs: uv sync --extra local-stt)
STT_ENGINE=auto
OPENAI_STT_MODEL=whisper-1
LOCAL_STT_MODEL=base

# --- Engines -----------------------------------------------------------------
# LLM_ENGINE: auto | anthropic | openai | offline
#   offline -> dependency-free extractive summarizer (no API needed)
LLM_ENGINE=auto

# --- Output ------------------------------------------------------------------
OUTPUT_DIR=output

# --- Backend API / database ---------------------------------------------------
# Swap for a Postgres/MySQL URL in deployment; the API layer doesn't change.
DATABASE_URL=sqlite:///./meeting_agent.db

# --- Browser -----------------------------------------------------------------
# Keep HEADLESS=0 so you can log in to Google/Zoom and see the meeting.
HEADLESS=0
# Persistent Chrome profile (login state survives between runs).
CHROME_USER_DATA_DIR=

# Default meeting length in minutes for `meeting-agent run`
DEFAULT_DURATION_MINUTES=30
