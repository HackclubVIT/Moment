# =============================================================================
# Moment AI Note Taker — Environment Variables
# =============================================================================
# Copy this file to .env in the root of the project and fill in your actual values.

# -- Groq Cloud (Speech-to-Text & LLM API) ------------------------------------
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-20b

# -- Modal (WhisperX cloud deployment) ----------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENDPOINT_URL=

# -- HuggingFace (pyannote gated models require an access token) --------------
HF_TOKEN=

# -- WhisperX Configuration ---------------------------------------------------
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=auto
WHISPER_TRANSLATE=true
WHISPER_MAX_CHUNK_HOURS=2

# -- Audio Recording ----------------------------------------------------------
WHISPER_SAMPLE_RATE=16000
WHISPER_CHANNELS=1

# -- Storage Paths (relative to project root) ---------------------------------
WHISPER_RECORDINGS_DIR=data/recordings
WHISPER_TRANSCRIPTS_DIR=data/transcripts

# -- Local Fallback -----------------------------------------------------------
WHISPER_LOCAL_MODEL=large-v3
WHISPER_LOCAL_COMPUTE=auto
